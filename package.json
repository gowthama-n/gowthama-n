{
  "name": "cypressauto",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run",
    "headTest": "npx cypress run --headed",
    "recordDashboardTest": "npx cypress run --record",
    "chromeTest": "npx cypress run --browser chrome",
    "getting1Test": "npx cypress run --spec \"cypress/e2e/1-getting-started/*.cy.{js,jsx,ts,tsx}\" ",
    "SmokeTest": "npx cypress run --spec \"cypress/e2e/1-getting-started/test10framework.cy.{js,jsx,ts,tsx}\" "
  },
  "author": "Gowthama N",
  "license": "ISC",
  "description": "",

  "devDependencies": {
    "cypress": "^13.17.0",
    "cypress-iframe": "^1.0.1",
    "cypress-mochawesome-reporter": "^3.8.2",
    "multiple-cucumber-html-reporter": "^3.9.0"
  },
  
  "cypress-cucumber-preprocessor": {
    "json": {
      "enabled": true,
      "output": "Cypress/cucumberReports/results.json"
    }
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.0",
    "@cypress/browserify-preprocessor": "latest"
  }
}
